# --------------------
# Python
# --------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# --------------------
# Virtual environments
# --------------------
.venv/
venv/
env/
ENV/

# --------------------
# PyTorch / TorchRL
# --------------------
*.pt
*.pth
*.ckpt
# Bundled teacher artifacts are the one exception (see teachers/README.md).
!teachers/**/*.pt
!teachers/**/*.pth

# --------------------
# Logs & outputs
# --------------------
logs/
runs/
wandb/
*.csv
# The data tables behind the committed figures are the exception: `results/` is
# ignored wholesale just below, so the blanket rule above is not what keeps
# per-run metrics.csv out, and without this it silently drops them too.
!analysis/figures/**/*.csv
*.mp4

# --------------------
# Data
# --------------------
results/

# --------------------
# OS / editor junk
# --------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/scheduled_tasks.lock

# --------------------
# Build artifacts
# --------------------
build/
dist/
*.egg-info/

# --------------------
# Temporary files
# --------------------
tmp/
scratch/
